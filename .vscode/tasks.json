{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UV: Run Lock",
      "type": "shell",
      "command": ["uv lock"],
      "problemMatcher": []
    },
    {
      "label": "UV: Run Upgrade",
      "type": "shell",
      "command": ["uv sync --upgrade"],
      "problemMatcher": []
    },
    {
      "label": "Ruff: Run Check",
      "type": "shell",
      "command": [
        "uv run ruff check --fix --show-fixes --config pyproject.toml"
      ],
      "problemMatcher": []
    },
    {
      "label": "Pyrefly: Run Type Checker",
      "type": "shell",
      "command": ["uv run pyrefly check ."],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Run Install",
      "type": "shell",
      "command": ["uv run pre-commit install"],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Run Autoupdate",
      "type": "shell",
      "command": ["uv run pre-commit autoupdate"],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Run Check",
      "type": "shell",
      "command": [
        "uv run pre-commit run --show-diff-on-failure --color=always --all-files"
      ],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Fix conflict with auto-fixes",
      "type": "shell",
      "command": ["git add ."],
      "problemMatcher": []
    },
    {
      "label": "PyTest: Run Tests",
      "type": "shell",
      "command": [
        "uv run python remove_pycache.py;",
        "uv run pytest -v tests/;",
        "uv run python remove_pycache.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Create New Docs",
      "type": "shell",
      "command": ["uv run mkdocs new ."],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Run Build",
      "type": "shell",
      "command": ["uv run mkdocs build"],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Run Serve",
      "type": "shell",
      "command": ["uv run mkdocs serve"],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Run Deploy 0.1",
      "type": "shell",
      "command": [
        "uv run mike deploy --push --update-aliases 0.1 latest;",
        "uv run mike set-default --push latest"
      ],
      "problemMatcher": []
    },
    {
      "label": "i18n: Generate .pot and .po files",
      "type": "shell",
      "command": ["cd builddir;", "meson compile defrag-pot;", "cd .."],
      "problemMatcher": []
    },
    {
      "label": "i18n: Update existing .po files",
      "type": "shell",
      "command": ["cd builddir;", "meson compile defrag-update-po;", "cd .."],
      "problemMatcher": []
    },
    {
      "label": "i18n: Compile .mo files",
      "type": "shell",
      "command": ["meson compile -C builddir;"],
      "problemMatcher": []
    },
    {
      "label": "Meson: Create App Settings",
      "type": "shell",
      "command": ["meson setup builddir"],
      "problemMatcher": []
    },
    {
      "label": "Meson: Rebuild App Settings",
      "type": "shell",
      "command": ["meson compile -C builddir"],
      "problemMatcher": []
    },
    {
      "label": "Meson: Reconfigure App Settings",
      "type": "shell",
      "command": ["meson setup --reconfigure builddir"],
      "problemMatcher": []
    },
    {
      "label": "PIP: Run flatpak-pip-generator",
      "type": "shell",
      "command": [
        "uv run python -m flatpak-pip-generator --runtime='org.gnome.Sdk//48' --requirements-file='requirements.txt' --ignore-installed='pygobject' --output build-aux/flatpak/pypi-dependencies.json;"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flatpak: Build App",
      "type": "shell",
      "command": [
        "flatpak-builder --force-clean .flatpak build-aux/flatpak/com.github.kebasyaty.Defrag.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flatpak: Run App",
      "type": "shell",
      "command": [
        "flatpak-builder --run --env=LC_ALL=ru_Ru.UTF-8 .flatpak build-aux/flatpak/com.github.kebasyaty.Defrag.json defrag"
      ],
      "problemMatcher": []
    }
  ]
}
